// Settings shared by every target. Signing is per developer: copy
// Local.xcconfig.example to Local.xcconfig (gitignored) and set your team there.

CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =

// The app's identity; replace App with the app's name. Every target's bundle identifier is
// built from APP_BUNDLE_IDENTIFIER. Entitlements and Info.plist files read
// APP_GROUP_IDENTIFIER, the App Group the app shares with its extensions; an app without one
// leaves the line out. Apple registers an identifier to one team, so a developer signing
// with another team names their own in Local.xcconfig.
APP_BUNDLE_IDENTIFIER = com.omarkhaled.salah.App
APP_GROUP_IDENTIFIER = group.com.omarkhaled.salah.App

#include? "Local.xcconfig"
